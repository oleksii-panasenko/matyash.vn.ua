---
// Маленька побудова циркулем і лінійкою в шапці сторінки, у тому ж стилі, що й на головній.
// Кожна сторінка має свою: публікації — золотий переріз, школа — вписане коло,
// аспіранту — бісектриса кута, конференція — три кола, що перетинаються.
interface Props { kind: 'golden' | 'incircle' | 'bisector' | 'circles' }
const { kind } = Astro.props;
---
<svg class={`page-figure ${kind}`} viewBox="0 0 240 220" aria-hidden="true" focusable="false">
  {kind === 'golden' && (
    <>
      <g class="faint">
        <line class="draw" style="--len:200" x1="10" y1="150" x2="210" y2="150" />
        <line class="draw" style="--len:120" x1="70" y1="150" x2="120" y2="50" />
        <path class="draw" style="--len:180" d="M120 50 A111.8 111.8 0 0 1 181.8 150" />
      </g>
      <path class="draw shape" style="--len:540" d="M20 50 H181.8 V150 H20 Z" />
      <path class="draw thin" style="--len:300" d="M120 50 V150 M120 111.8 H181.8 M143.6 111.8 V150 M120 126.4 H143.6" />
      <path class="draw result" style="--len:300" d="M20 150 A100 100 0 0 1 120 50 A61.8 61.8 0 0 1 181.8 111.8 A38.2 38.2 0 0 1 143.6 150 A23.6 23.6 0 0 1 120 126.4" />
      <g class="pts"><circle cx="70" cy="150" r="2.6" /><circle cx="120" cy="50" r="2.6" /><circle cx="181.8" cy="150" r="2.6" /></g>
    </>
  )}
  {kind === 'incircle' && (
    <>
      <g class="faint">
        <circle class="draw" style="--len:620" cx="120" cy="132.69" r="97.43" />
        <path class="draw" style="--len:440" d="M30 170 L103.13 123.21 M210 170 L103.13 123.21 M90 40 L103.13 123.21" />
      </g>
      <path class="draw shape" style="--len:520" d="M30 170 L210 170 L90 40 Z" />
      <circle class="draw result filled" style="--len:300" cx="103.13" cy="123.21" r="46.79" />
      <g class="pts"><circle cx="103.13" cy="123.21" r="2.6" /><circle cx="30" cy="170" r="2.6" /><circle cx="210" cy="170" r="2.6" /><circle cx="90" cy="40" r="2.6" /></g>
    </>
  )}
  {kind === 'bisector' && (
    <>
      <g class="faint">
        <path class="draw" style="--len:100" d="M92.52 115.26 A90 90 0 0 1 119.51 189.41" />
        <path class="draw" style="--len:40" d="M155 119.38 A70 70 0 0 1 179.36 142.91" />
        <path class="draw" style="--len:40" d="M168.26 112.41 A70 70 0 0 1 164.72 146.09" />
      </g>
      <path class="draw shape" style="--len:400" d="M175.5 57.9 L30 180 L220 180" />
      <line class="draw result" style="--len:210" x1="30" y1="180" x2="217.9" y2="111.6" />
      <g class="pts"><circle cx="30" cy="180" r="2.6" /><circle cx="120" cy="180" r="2.6" /><circle cx="98.94" cy="122.15" r="2.6" /><circle cx="168.55" cy="129.57" r="2.6" /></g>
    </>
  )}
  {kind === 'circles' && (
    <>
      <circle class="draw venn" style="--len:380" cx="120" cy="85" r="60" />
      <circle class="draw venn" style="--len:380" cx="150.31" cy="137.5" r="60" />
      <circle class="draw venn" style="--len:380" cx="89.69" cy="137.5" r="60" />
      <g class="pts"><circle cx="120" cy="85" r="2.6" /><circle cx="150.31" cy="137.5" r="2.6" /><circle cx="89.69" cy="137.5" r="2.6" /></g>
    </>
  )}
</svg>
<style>
  .page-figure { display: block; width: 100%; height: auto; overflow: visible; }
  .faint { stroke: var(--line); stroke-width: 1.2; fill: none; }
  .shape { stroke: var(--ink); stroke-width: 1.4; fill: none; stroke-linejoin: round; opacity: 0.75; }
  .thin { stroke: var(--ink); stroke-width: 0.9; fill: none; opacity: 0.45; }
  .result { stroke: var(--accent); stroke-width: 2.2; fill: none; stroke-linecap: round; }
  .filled { fill: color-mix(in srgb, var(--accent) 8%, transparent); }
  .venn { stroke: var(--accent); stroke-width: 1.6; fill: color-mix(in srgb, var(--accent) 9%, transparent); }
  .pts { fill: var(--ink); }
  .draw { stroke-dasharray: var(--len) var(--len); stroke-dashoffset: 0; }
  @media (prefers-reduced-motion: no-preference) {
    .draw { animation: draw 1.1s ease-out both; }
    .faint .draw { animation-duration: 0.9s; }
    .shape { animation-delay: 0.5s; }
    .thin { animation-delay: 0.9s; }
    .result { animation: draw 1.2s ease-in-out 1.1s both; }
    .venn:nth-of-type(2) { animation-delay: 0.25s; }
    .venn:nth-of-type(3) { animation-delay: 0.5s; }
    .filled, .venn { animation-name: draw, fill-in; animation-duration: 1.2s, 0.6s; }
    .pts { animation: appear 0.5s ease 1.6s both; }
  }
  @keyframes draw { from { stroke-dashoffset: var(--len); } to { stroke-dashoffset: 0; } }
  @keyframes fill-in { from { fill-opacity: 0; } }
  @keyframes appear { from { opacity: 0; } }
</style>
